# orbs.meme public configuration template
# Copy to .env.local for local development. Never commit real credentials.

# Public web configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_ORBS_PROGRAM_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_ARENA_REALTIME_URL=
NEXT_PUBLIC_RACE_REALTIME_URL=

# Canonical server/site URLs (set production HTTPS URLs in deployment)
SITE_URL=http://localhost:3000
ORBS_SITE_URL=http://localhost:3000
X_REDIRECT_URI=http://localhost:3000/api/x/callback

# Durable state: use either Upstash names or Vercel KV-compatible aliases
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Solana RPC fallbacks / server RPC
HELIUS_RPC_URL=
SOLANA_MAINNET_RPC=
SOLANA_RPC_URL=
ORBS_PROGRAM_ID=

# Jupiter API (token metadata / pricing; either name is accepted)
JUPITER_API_KEY=
JUP_API_KEY=

# X OAuth / API
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
ORBS_X_TOKEN_ENCRYPTION_KEY=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=

# Application signing / sealed-game secrets
ORBS_SESSION_SIGNING_KEY=
ORBS_GAME_SECRET_KEY=
ORBS_FUNDING_QUOTE_SIGNING_KEY=

# Operator policy
ADMIN_WALLET=
ORBS_ADMIN_WALLETS=

# Solana relayer (server only; never expose publicly)
ORBS_RELAYER_SECRET_KEY=

# Turnkey claim authority (server only)
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_CLAIM_PRIVATE_KEY_ID=
TURNKEY_CLAIM_ADDRESS=

# Realtime authority shared secrets / service URLs
ARENA_RUNTIME_HMAC_KEY=
RACE_RUNTIME_HMAC_KEY=
RACE_REALTIME_URL=

# Platform-provided values such as NODE_ENV, PORT, VERCEL_URL and
# VERCEL_PROJECT_PRODUCTION_URL normally do not need to be set manually.
